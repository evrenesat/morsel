<resources>
    <style name="Theme.Morsel" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="Theme.Morsel.Popup">
        <item name="android:windowIsFloating">true</item>
        <!-- Inherited translucency makes the window span the whole display
             (insets become nonzero inside it), so taps next to the card land
             INSIDE the invisible full-screen window and ACTION_OUTSIDE never
             fires - outside-tap dismissal cannot work. A floating card must
             be a wrap-content window with the dim covering the rest. -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.24</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
